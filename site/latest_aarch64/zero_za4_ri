    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckStreamingSVEAndZAEnabled_0" title="">CheckStreamingSVEAndZAEnabled</a>();
let VL : integer{} = <a href="shared_pseudocode.html#func_CurrentVL_0" title="">CurrentVL</a>();
let vectors : integer = VL DIV 8;
let vstride : integer = vectors DIV ngrp;
let vbase : bits(32) = <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{32}(v);
var vec : integer = (UInt(vbase) + offset) MOD vstride;
vec = vec - vec MOD nvec;
for r = 0 to ngrp-1 do
    for i = 0 to nvec-1 do
        <a href="shared_pseudocode.html#accessor_ZAvector_2" title="">ZAvector</a>{VL}(vec + i) = Zeros{VL};
    end;
    vec = vec + vstride;
end;</p></div>
