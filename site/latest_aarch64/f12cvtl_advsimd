    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckFPMREnabled_0" title="">CheckFPMREnabled</a>(); <a href="shared_pseudocode.html#func_AArch64_CheckFPAdvSIMDEnabled_0" title="">AArch64_CheckFPAdvSIMDEnabled</a>();
let operand : bits(64) = Vpart{}(n, part);
var result : bits(128);

for e = 0 to elements-1 do
    result[e*:16] = <a href="shared_pseudocode.html#func_FP8ConvertFP_4" title="">FP8ConvertFP</a>(operand[e*:8], issrc2, FPCR(), FPMR());
end;

<a href="shared_pseudocode.html#accessor_V_2" title="">V</a>{128}(d) = result;</p></div>
