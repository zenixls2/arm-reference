    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckSVEEnabled_0" title="">CheckSVEEnabled</a>();
let VL : integer{} = <a href="shared_pseudocode.html#func_CurrentVL_0" title="">CurrentVL</a>();
let PL : integer{} = VL DIV 8;
let elements : integer = VL DIV esize;
let count : integer = <a href="shared_pseudocode.html#func_DecodePredCount_2" title="">DecodePredCount</a>(pat, esize);
var result : bits(PL);
let psize : integer{} = esize DIV 8;

for e = 0 to elements-1 do
    let pbit : bit = if e &lt; count then '1' else '0';
    result[e*:psize] = ZeroExtend{psize}(pbit);
end;

if setflags then
    PSTATE.[N,Z,C,V] = <a href="shared_pseudocode.html#func_PredTest_4" title="">PredTest</a>{PL}(result, result, esize);
end;
<a href="shared_pseudocode.html#accessor_P_2" title="">P</a>{PL}(d) = result;</p></div>
  <h2>Operational information</h2>
    
      
        <p class="aml" data-pagefind-body="1">If FEAT_SME is implemented and the PE is in Streaming SVE mode, then any subsequent instruction
that is dependent on the NZCV condition flags written by this instruction might be significantly delayed.</p>
      
    
