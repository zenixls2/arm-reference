    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckFPMREnabled_0" title="">CheckFPMREnabled</a>(); <a href="shared_pseudocode.html#func_AArch64_CheckFPAdvSIMDEnabled_0" title="">AArch64_CheckFPAdvSIMDEnabled</a>();
let operand1 : bits(datasize) = V{}(n);
let operand2 : bits(datasize) = V{}(m);
let operand3 : bits(datasize) = V{}(d);
var result : bits(datasize);

for e = 0 to elements-1 do
    let op1 : bits(esize) = operand1[e*:esize];
    let op2 : bits(esize) = operand2[e*:esize];
    var sum : bits(esize) = operand3[e*:esize];

    sum = <a href="shared_pseudocode.html#func_FP8DotAddFP_7" title="">FP8DotAddFP</a>{esize, esize}(sum, op1, op2, FPCR(), FPMR());
    result[e*:esize] = sum;
end;

<a href="shared_pseudocode.html#accessor_V_2" title="">V</a>{datasize}(d) = result;</p></div>
