      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;Xn&gt;</td><td><a id="XnOrXZR__12"></a>
        
          <p class="aml" data-pagefind-body="1">Is the 64-bit name of the first general-purpose source register, encoded in the "Rn" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;Xm&gt;</td><td><a id="XmOrXZR__4"></a>
        
          <p class="aml" data-pagefind-body="1">Is the 64-bit name of the second general-purpose source register, encoded in the "Rm" field.</p>
        
      </td></tr></table></div><div class="syntax-notes"></div><h3 class="aliastable" id="">Alias Conditions</h3><table class="aliastable"><thead><tr><th>Alias</th><th>Is preferred when</th></tr></thead><tbody><tr><td><a href="cinc_csinc.html" title="Conditional increment">CINC</a></td><td class="notfirst"><span class="pseudocode">Rm != '11111' &amp;&amp; Rn != '11111' &amp;&amp; !(cond IN {'111x'}) &amp;&amp; Rn == Rm</span></td></tr><tr><td><a href="cset_csinc.html" title="Conditional set">CSET</a></td><td class="notfirst"><span class="pseudocode">Rm == '11111' &amp;&amp; Rn == '11111' &amp;&amp; !(cond IN {'111x'})</span></td></tr></tbody></table>
    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode">var result : bits(datasize);
if <a href="shared_pseudocode.html#func_ConditionHolds_1" title="">ConditionHolds</a>(condition) then
    result = <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{datasize}(n);
else
    result = <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{datasize}(m) + 1;
end;

<a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{datasize}(d) = result;</p></div>
  <h2>Operational information</h2>
    
      
        <p class="aml" data-pagefind-body="1">This instruction is a data-independent-time instruction as described in <a class="armarm-xref" title="Reference to Armv8 ARM section" data-linkend="BEICCDDAB3">About PSTATE.DIT</a>.</p>
      
    
