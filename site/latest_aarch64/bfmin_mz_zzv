    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckStreamingSVEEnabled_0" title="">CheckStreamingSVEEnabled</a>();
let VL : integer{} = <a href="shared_pseudocode.html#func_CurrentVL_0" title="">CurrentVL</a>();
let elements : integer = VL DIV 16;
var results : array [[4]] of bits(VL);

for r = 0 to nreg-1 do
    let operand1 : bits(VL) = <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(dn+r);
    let operand2 : bits(VL) = <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(m);
    for e = 0 to elements-1 do
        let element1 : bits(16) = operand1[e*:16];
        let element2 : bits(16) = operand2[e*:16];
        results[[r]][e*:16] = <a href="shared_pseudocode.html#func_BFMin_4" title="">BFMin</a>{16}(element1, element2, FPCR());
    end;
end;

for r = 0 to nreg-1 do
    <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(dn+r) = results[[r]];
end;</p></div>
