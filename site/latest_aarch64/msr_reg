    </p><a href="/">← Home</a><pagefind-searchbox></pagefind-searchbox><script type="module" src="/pagefind/pagefind-component-ui.js"></script><script type="text/javascript" src="/static/pagefind.js"></script><h1 class="instruction-section" data-pagefind-body="1" data-pagefind-weight="10" data-pagefind-sort="title">MSR (register)</h1><p class="insn_subtitle" data-pagefind-body="1">Move general-purpose register to System register</p>
      <p class="aml" data-pagefind-body="1">This instruction allows the PE to write an
AArch64 System register from a general-purpose register.</p>
    
    <p class="desc"></p><div class="regdiagram-32"><table class="regdiagram"><thead><tr><td>31</td><td>30</td><td>29</td><td>28</td><td>27</td><td>26</td><td>25</td><td>24</td><td>23</td><td>22</td><td>21</td><td>20</td><td>19</td><td>18</td><td>17</td><td>16</td><td>15</td><td>14</td><td>13</td><td>12</td><td>11</td><td>10</td><td>9</td><td>8</td><td>7</td><td>6</td><td>5</td><td>4</td><td>3</td><td>2</td><td>1</td><td>0</td></tr></thead><tbody><tr class="firstrow"><td class="l">1</td><td>1</td><td class="r">0</td><td class="l">1</td><td>0</td><td class="r">1</td><td class="l">0</td><td>1</td><td>0</td><td class="r">0</td><td class="lr">0</td><td class="lr">1</td><td class="lr">o0</td><td colspan="3" class="lr">op1</td><td colspan="4" class="lr">CRn</td><td colspan="4" class="lr">CRm</td><td colspan="3" class="lr">op2</td><td colspan="5" class="lr">Rt</td></tr><tr class="secondrow"><td colspan="3"></td><td colspan="3"></td><td colspan="4"></td><td class="droppedname">L</td><td></td><td></td><td colspan="3"></td><td colspan="4"></td><td colspan="4"></td><td colspan="3"></td><td colspan="5"></td></tr></tbody></table></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">Encoding</h4><a id="MSR_SR_systemmove"></a></div><p class="asm-code">MSR  (<a href="#MRS_values" title='Is a System register name, encoded in "o0:op1:CRn:CRm:op2".  The System register names are defined in x[AArch64 System Register Descriptions](autogen.registers.AArch64).'>&lt;systemreg&gt;</a>|S<a href="#op0_option" title="Is an unsigned immediate, ">&lt;op0&gt;</a>_<a href="#op1" title='Is a 3-bit unsigned immediate, in the range 0 to 7, encoded in the "op1" field.'>&lt;op1&gt;</a>_<a href="#Cn" title="Is a name 'Cn', with 'n' in the range 0 to 15, encoded in the &quot;CRn&quot; field.">&lt;Cn&gt;</a>_<a href="#Cm" title="Is a name 'Cm', with 'm' in the range 0 to 15, encoded in the &quot;CRm&quot; field.">&lt;Cm&gt;</a>_<a href="#op2" title='Is a 3-bit unsigned immediate, in the range 0 to 7, encoded in the "op2" field.'>&lt;op2&gt;</a>), <a href="#XtOrXZR__3" title='Is the 64-bit name of the general-purpose source register, encoded in the "Rt" field.'>&lt;Xt&gt;</a></p></div><h4>Decode</h4><p class="pseudocode">let t : integer       = UInt(Rt);
let sys_op0 : bits(2) = '1' :: o0;
let sys_op1 : bits(3) = op1;
let sys_op2 : bits(3) = op2;
let sys_crn : bits(4) = CRn;
let sys_crm : bits(4) = CRm;</p>
  <div class="encoding-notes"></div><h2 class="explanations">Assembler Symbols</h2><div class="explanations"><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;systemreg&gt;</td><td><a id="MRS_values"></a>
        
          <p class="aml" data-pagefind-body="1">Is a System register name, encoded in "o0:op1:CRn:CRm:op2".</p>
          <p class="aml" data-pagefind-body="1">The System register names are defined in <a class="armarm-xref" title="Reference to Armv8 ARM section" data-linkend="autogen.registers.AArch64">AArch64 System Register Descriptions</a>.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;op0&gt;</td><td><a id="op0_option"></a>
        <p>Is an unsigned immediate, 
          encoded in
          <q>o0</q>:
            </p>
        <table class="valuetable">
          
            <thead>
              <tr>
                <th class="bitfield">o0</th>
                <th class="symbol">&lt;op0&gt;</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="bitfield">0</td>
                <td class="symbol">2</td>
              </tr>
              <tr>
                <td class="bitfield">1</td>
                <td class="symbol">3</td>
              </tr>
            </tbody>
          
        </table>
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;op1&gt;</td><td><a id="op1"></a>
        
          <p class="aml" data-pagefind-body="1">Is a 3-bit unsigned immediate, in the range 0 to 7, encoded in the "op1" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;Cn&gt;</td><td><a id="Cn"></a>
        
          <p class="aml" data-pagefind-body="1">Is a name 'Cn', with 'n' in the range 0 to 15, encoded in the "CRn" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;Cm&gt;</td><td><a id="Cm"></a>
        
          <p class="aml" data-pagefind-body="1">Is a name 'Cm', with 'm' in the range 0 to 15, encoded in the "CRm" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;op2&gt;</td><td><a id="op2"></a>
        
          <p class="aml" data-pagefind-body="1">Is a 3-bit unsigned immediate, in the range 0 to 7, encoded in the "op2" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;Xt&gt;</td><td><a id="XtOrXZR__3"></a>
        
          <p class="aml" data-pagefind-body="1">Is the 64-bit name of the general-purpose source register, encoded in the "Rt" field.</p>
        
      </td></tr></table></div><div class="syntax-notes"></div>
    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode">AArch64_SysRegWrite(sys_op0, sys_op1, sys_crn, sys_crm, sys_op2, t);</p></div>
