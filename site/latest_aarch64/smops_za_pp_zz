    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckStreamingSVEAndZAEnabled_0" title="">CheckStreamingSVEAndZAEnabled</a>();
let VL : integer{} = <a href="shared_pseudocode.html#func_CurrentVL_0" title="">CurrentVL</a>();
let PL : integer{} = VL DIV 8;
let dim : integer{} = VL DIV esize;
let mask1 : bits(PL) = <a href="shared_pseudocode.html#accessor_P_2" title="">P</a>{PL}(a);
let mask2 : bits(PL) = <a href="shared_pseudocode.html#accessor_P_2" title="">P</a>{PL}(b);
let operand1 : bits(VL) = <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(n);
let operand2 : bits(VL) = <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(m);
let operand3 : bits(dim*dim*esize) = <a href="shared_pseudocode.html#accessor_ZAtile_3" title="">ZAtile</a>{dim*dim*esize}(da, esize);
var result : bits(dim*dim*esize);
var prod : integer;

for row = 0 to dim-1 do
    for col = 0 to dim-1 do
        var sum : bits(esize) = operand3[(row*dim+col)*:esize];
        for k = 0 to 3 do
            if (<a href="shared_pseudocode.html#func_ActivePredicateElement_4" title="">ActivePredicateElement</a>{PL}(mask1, 4*row + k, esize DIV 4) &amp;&amp;
                  <a href="shared_pseudocode.html#func_ActivePredicateElement_4" title="">ActivePredicateElement</a>{PL}(mask2, 4*col + k, esize DIV 4)) then
                let op1elt : bits(esize DIV 4) = operand1[(4*row + k)*:(esize DIV 4)];
                let op2elt : bits(esize DIV 4) = operand2[(4*col + k)*:(esize DIV 4)];
                let element1 : integer = if op1_unsigned then UInt(op1elt) else SInt(op1elt);
                let element2 : integer = if op2_unsigned then UInt(op2elt) else SInt(op2elt);
                prod = element1 * element2;
                sum = sum - prod;
            end;
        end;
        result[(row*dim+col)*:esize] = sum;
    end;
end;

<a href="shared_pseudocode.html#accessor_ZAtile_3" title="">ZAtile</a>{dim*dim*esize}(da, esize) = result;</p></div>
