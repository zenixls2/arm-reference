the "Zm" field.'>&lt;Zm&gt;</a>.H</p></div><h4>Decode</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_SME_I16I64) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
