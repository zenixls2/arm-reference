    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode">var result : bits(64);
let base : bits(64) = if n == 31 then <a href="shared_pseudocode.html#accessor_SP_1" title="">SP</a>{64}() else <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{64}(n);
let offset : bits(64) = LSL(<a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{64}(m), shift);

result = base - offset;
result = <a href="shared_pseudocode.html#func_PointerAddCheck_2" title="">PointerAddCheck</a>(result, base);

if d == 31 then
    <a href="shared_pseudocode.html#accessor_SP_1" title="">SP</a>{64}() = result;
else
    <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{64}(d) = result;
end;</p></div>
