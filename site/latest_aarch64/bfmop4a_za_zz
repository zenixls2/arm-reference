    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckStreamingSVEAndZAEnabled_0" title="">CheckStreamingSVEAndZAEnabled</a>();
let VL : integer{} = <a href="shared_pseudocode.html#func_CurrentVL_0" title="">CurrentVL</a>();
let hvsize : integer{} = VL DIV 2;
let dim : integer{} = hvsize DIV 16;
let tilesize : integer{} = 4 * dim * dim * 16;
let op3 : bits(tilesize) = <a href="shared_pseudocode.html#accessor_ZAtile_3" title="">ZAtile</a>{tilesize}(da, 16);
var result : bits(tilesize);

for outprod = 0 to 3 do
    let row_hv : integer = outprod DIVRM 2;
    let col_hv : integer = outprod MOD 2;
    let row_base : integer = row_hv * dim;
    let col_base : integer = col_hv * dim;

    let op1 : bits(VL) = <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(n + (nreg-1) * col_hv);
    let op2 : bits(VL) = <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(m + (mreg-1) * row_hv);

    for row = 0 to dim-1 do
        for col = 0 to dim-1 do
            let row_idx : integer = row_base + row;
            let col_idx : integer = col_base + col;
            let tile_idx : integer = row_idx * dim * 2 + col_idx;

            let elem1 : bits(16) = op1[row_idx*:16];
            let elem2 : bits(16) = op2[col_idx*:16];
            let elem3 : bits(16) = op3[tile_idx*:16];
            result[tile_idx*:16] = <a href="shared_pseudocode.html#func_BFMulAdd_ZA_4" title="">BFMulAdd_ZA</a>(elem3, elem1, elem2, FPCR());
        end;
    end;
end;
<a href="shared_pseudocode.html#accessor_ZAtile_3" title="">ZAtile</a>{tilesize}(da, 16) = result;</p></div>
