    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_AArch64_CheckFPEnabled_0" title="">AArch64_CheckFPEnabled</a>();

var fltval : bits(fltsize);
var intval : bits(intsize);
let merge : boolean = <a href="shared_pseudocode.html#func_IsMerging_1" title="">IsMerging</a>(FPCR());
var result : bits(128) = if merge then <a href="shared_pseudocode.html#accessor_V_2" title="">V</a>{128}(d) else Zeros{128};

fltval = <a href="shared_pseudocode.html#accessor_V_2" title="">V</a>{fltsize}(n);
intval = <a href="shared_pseudocode.html#func_FPToFixed_7" title="">FPToFixed</a>{intsize, fltsize}(fltval, 0, FALSE, FPCR(), <a href="shared_pseudocode.html#enum_FPRounding_ZERO" title="">FPRounding_ZERO</a>);
result[0+:intsize] = intval;

<a href="shared_pseudocode.html#accessor_V_2" title="">V</a>{128}(d) = result;</p></div>
