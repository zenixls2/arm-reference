    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckStreamingSVEAndZAEnabled_0" title="">CheckStreamingSVEAndZAEnabled</a>();
let VL : integer{} = <a href="shared_pseudocode.html#func_CurrentVL_0" title="">CurrentVL</a>();
let hvsize : integer{} = VL DIV 2;
let dim : integer{} = hvsize DIV esize;
let tilesize : integer{} = 4 * dim * dim * esize;
let op3 : bits(tilesize) = ZAtile{}(da, esize);
var result : bits(tilesize);
var prod : integer;

for outprod = 0 to 3 do
    let row_hv : integer = outprod DIVRM 2;
    let col_hv : integer = outprod MOD 2;
    let row_base : integer = row_hv * dim;
    let col_base : integer = col_hv * dim;

    let op1 : bits(VL) = Z{}(n + (nreg-1)*col_hv);
    let op2 : bits(VL) = Z{}(m + (mreg-1)*row_hv);

    for row = 0 to dim-1 do
        for col = 0 to dim-1 do
            let row_idx : integer = row_base + row;
            let col_idx : integer = col_base + col;
            let tile_idx : integer = row_idx * dim * 2 + col_idx;

            var sum : bits(esize) = op3[tile_idx*:esize];

            for k = 0 to 1 do
                let op1elt : bits(esize DIV 2) = op1[(2*row_idx + k)*:(esize DIV 2)];
                let op2elt : bits(esize DIV 2) = op2[(2*col_idx + k)*:(esize DIV 2)];
                let element1 : integer = if op1_unsigned then UInt(op1elt) else SInt(op1elt);
                let element2 : integer = if op2_unsigned then UInt(op2elt) else SInt(op2elt);
                prod = element1 * element2;
                if sub_op then prod = -prod; end;
                sum = sum + prod;
            end;
            result[tile_idx*:esize] = sum;
        end;
    end;
end;
<a href="shared_pseudocode.html#accessor_ZAtile_3" title="">ZAtile</a>{tilesize}(da, esize) = result;</p></div>
