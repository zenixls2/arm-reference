he "H:L:M" fields.'>&lt;index&gt;</a>]</p></div><h4>Decode</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_FHM) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
if sz == '1' then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
let d : integer = UInt(Rd);
let n : integer = UInt(Rn);
let m : integer = UInt('0'::Rm);    // Vm can only be in bottom 16 registers.
let index : integer = UInt(H::L::M);

let esize : integer{} = 32;
let datasize : integer{} = 64 &lt;&lt; UInt(Q);
let elements : integer = datasize DIV esize;

let part : integer = 0;</p>
