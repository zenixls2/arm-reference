 the "H:L:M" fields.'>&lt;index&gt;</a>]</p></div><h4>Decode</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_FHM) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
