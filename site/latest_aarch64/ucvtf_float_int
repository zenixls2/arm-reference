            <span style="font-size:smaller;"><br></br>(FEAT_FP)
            </span></h4><a id="UCVTF_D64_float2int"></a><span class="bitdiff"> (sf == 1 &amp;&amp; ftype == 01)</span></div><p class="asm-code">UCVTF  <a href="#Dd" title='Is the 64-bit name of the SIMD&amp;FP destination register, encoded in the "Rd" field.'>&lt;Dd&gt;</a>, <a href="#XnOrXZR__11" title='Is the 64-bit name of the general-purpose source register, encoded in the "Rn" field.'>&lt;Xn&gt;</a></p></div><h4>Decode (all encodings)</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_FP) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
if ftype == '10' then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
if ftype == '11' &amp;&amp; !IsFeatureImplemented(FEAT_FP16) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;

let d : integer{} = UInt(Rd);
let n : integer{} = UInt(Rn);

let intsize : integer{} = 32 &lt;&lt; UInt(sf);
let decode_fltsize : integer{} = 8 &lt;&lt; UInt(ftype XOR '10');
let unsigned : boolean    = TRUE;</p>
