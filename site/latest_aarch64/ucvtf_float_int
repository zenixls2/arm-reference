    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_AArch64_CheckFPEnabled_0" title="">AArch64_CheckFPEnabled</a>();

let fltsize : integer{} = if <a href="shared_pseudocode.html#func_IsMerging_1" title="">IsMerging</a>(FPCR()) then 128 else decode_fltsize;

let intval : bits(intsize) = X{}(n);
let rounding : <a href="shared_pseudocode.html#type_FPRounding" title="">FPRounding</a>  = <a href="shared_pseudocode.html#func_FPRoundingMode_1" title="">FPRoundingMode</a>(FPCR());
let fracbits : integer = 0;
var fltval : bits(fltsize) = if <a href="shared_pseudocode.html#func_IsMerging_1" title="">IsMerging</a>(FPCR()) then <a href="shared_pseudocode.html#accessor_V_2" title="">V</a>{fltsize}(d) else Zeros{fltsize};
fltval[0+:decode_fltsize] = <a href="shared_pseudocode.html#func_FixedToFP_7" title="">FixedToFP</a>{decode_fltsize, intsize}(intval, fracbits, unsigned,
                                                               FPCR(), rounding);

<a href="shared_pseudocode.html#accessor_V_2" title="">V</a>{fltsize}(d) = fltval;</p></div>
