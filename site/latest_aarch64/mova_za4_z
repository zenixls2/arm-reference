    let result : bits(VL) = <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(n + r);
    <a href="shared_pseudocode.html#accessor_ZAslice_5" title="">ZAslice</a>{VL}(d, esize, vertical, slice + r) = result;
