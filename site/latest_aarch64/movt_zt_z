    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckStreamingSVEEnabled_0" title="">CheckStreamingSVEEnabled</a>();
<a href="shared_pseudocode.html#func_CheckSMEZT0Enabled_0" title="">CheckSMEZT0Enabled</a>();
let VL : integer{} = <a href="shared_pseudocode.html#func_CurrentVL_0" title="">CurrentVL</a>();
let tsize : integer{} = (if VL &lt;= 512 then VL else 512) as integer{128, 256, 512};
let offset : integer = imm MOD (512 DIV tsize);
var result : bits(512) = if imm == 0 then Zeros{512} else <a href="shared_pseudocode.html#accessor_ZT0_1" title="">ZT0</a>{512}();
result[offset*:tsize] = <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(t)[tsize-1:0];
<a href="shared_pseudocode.html#accessor_ZT0_1" title="">ZT0</a>{512}() = result;</p></div>
