    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckStreamingSVEEnabled_0" title="">CheckStreamingSVEEnabled</a>();
let VL : integer{} = <a href="shared_pseudocode.html#func_CurrentVL_0" title="">CurrentVL</a>();
let elements : integer = VL DIV 32;
var results : array [[4]] of bits(VL);

for r = 0 to nreg-1 do
    let operand : bits(VL) = <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(n+r);
    for e = 0 to elements-1 do
        let element : bits(32) = operand[e*:32];
        results[[r]][e*:32] = <a href="shared_pseudocode.html#func_FPRoundInt_5" title="">FPRoundInt</a>{32}(element, FPCR(), rounding, exact);
    end;
end;

for r = 0 to nreg-1 do
    <a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(d+r) = results[[r]];
end;</p></div>
