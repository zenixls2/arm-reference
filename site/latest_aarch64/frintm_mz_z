          </span></h3><div class="regdiagram-32"><table class="regdiagram"><thead><tr><td>31</td><td>30</td><td>29</td><td>28</td><td>27</td><td>26</td><td>25</td><td>24</td><td>23</td><td>22</td><td>21</td><td>20</td><td>19</td><td>18</td><td>17</td><td>16</td><td>15</td><td>14</td><td>13</td><td>12</td><td>11</td><td>10</td><td>9</td><td>8</td><td>7</td><td>6</td><td>5</td><td>4</td><td>3</td><td>2</td><td>1</td><td>0</td></tr></thead><tbody><tr class="firstrow"><td class="lr">1</td><td class="l">1</td><td class="r">0</td><td class="l">0</td><td>0</td><td>0</td><td class="r">0</td><td class="lr">1</td><td class="l">1</td><td class="r">0</td><td class="lr">1</td><td class="l">1</td><td class="r">1</td><td class="l">0</td><td>1</td><td class="r">0</td><td class="l">1</td><td>1</td><td>1</td><td>0</td><td>0</td><td class="r">0</td><td colspan="3" class="lr">Zn</td><td class="l">0</td><td class="r">0</td><td colspan="3" class="lr">Zd</td><td class="l">0</td><td class="r">0</td></tr><tr class="secondrow"><td></td><td colspan="2"></td><td colspan="4"></td><td></td><td colspan="2" class="droppedname">size</td><td></td><td colspan="2"></td><td colspan="3" class="droppedname">opc</td><td colspan="6"></td><td colspan="3"></td><td colspan="2"></td><td colspan="3"></td><td colspan="2"></td></tr></tbody></table></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">Encoding</h4><a id="frintm_mz_z_4"></a></div><p class="asm-code">FRINTM  { <a href="#Zd1__2" title='For the "Four registers" variant: is the name of the first scalable vector register of the destination multi-vector group, encoded as "Zd" times 4.'>&lt;Zd1&gt;</a>.S-<a href="#Zd4" title='For the "Consecutive" variant: is the name of the fourth scalable vector register of the destination multi-vector group, encoded as "Zd" times 4 plus 3.'>&lt;Zd4&gt;</a>.S }, { <a href="#Zn1__6" title='For the "Four registers" variant: is the name of the first scalable vector register of the source multi-vector group, encoded as "Zn" times 4.'>&lt;Zn1&gt;</a>.S-<a href="#Zn4__3" title='Is the name of the fourth scalable vector register of the source multi-vector group, encoded as "Zn" times 4 plus 3.'>&lt;Zn4&gt;</a>.S }</p></div><h4>Decode</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_SME2) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
