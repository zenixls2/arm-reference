    </p><a href="/">← Home</a><pagefind-searchbox></pagefind-searchbox><script type="module" src="/pagefind/pagefind-component-ui.js"></script><script type="text/javascript" src="/static/pagefind.js"></script><h1 class="instruction-section" data-pagefind-body="1" data-pagefind-weight="10" data-pagefind-sort="title">ADRP</h1><p class="insn_subtitle" data-pagefind-body="1">Form PC-relative address to 4KB page</p>
      <p class="aml" data-pagefind-body="1">This instruction adds an immediate value that is
shifted left by 12 bits, to the PC value to form a PC-relative address,
with the bottom 12 bits masked out, and writes the result to the
destination register.</p>
    
    <p class="desc"></p><div class="regdiagram-32"><table class="regdiagram"><thead><tr><td>31</td><td>30</td><td>29</td><td>28</td><td>27</td><td>26</td><td>25</td><td>24</td><td>23</td><td>22</td><td>21</td><td>20</td><td>19</td><td>18</td><td>17</td><td>16</td><td>15</td><td>14</td><td>13</td><td>12</td><td>11</td><td>10</td><td>9</td><td>8</td><td>7</td><td>6</td><td>5</td><td>4</td><td>3</td><td>2</td><td>1</td><td>0</td></tr></thead><tbody><tr class="firstrow"><td class="lr">1</td><td colspan="2" class="lr">immlo</td><td class="l">1</td><td>0</td><td class="r">0</td><td class="l">0</td><td class="r">0</td><td colspan="19" class="lr">immhi</td><td colspan="5" class="lr">Rd</td></tr><tr class="secondrow"><td class="droppedname">op</td><td colspan="2"></td><td colspan="3"></td><td colspan="2"></td><td colspan="19"></td><td colspan="5"></td></tr></tbody></table></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">Encoding</h4><a id="ADRP_only_pcreladdr"></a></div><p class="asm-code">ADRP  <a href="#XdOrXZR__6" title='Is the 64-bit name of the general-purpose destination register, encoded in the "Rd" field.'>&lt;Xd&gt;</a>, <a href="#immhiimmlo_offset__2" title='Is the program label whose 4KB page address is to be calculated. Its offset from the page address of this instruction, in the range +/-4GB, is encoded as "immhi:immlo" times 4096.'>&lt;label&gt;</a></p></div><h4>Decode</h4><p class="pseudocode">let d : integer{} = UInt(Rd);
let imm : bits(64) = SignExtend{}(immhi::immlo::Zeros{12});</p>
  <div class="encoding-notes"></div><h2 class="explanations">Assembler Symbols</h2><div class="explanations"><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;Xd&gt;</td><td><a id="XdOrXZR__6"></a>
        
          <p class="aml" data-pagefind-body="1">Is the 64-bit name of the general-purpose destination register, encoded in the "Rd" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;label&gt;</td><td><a id="immhiimmlo_offset__2"></a>
        
          <p class="aml" data-pagefind-body="1">Is the program label whose 4KB page address is to be calculated. Its offset from the page address of this instruction, in the range +/-4GB, is encoded as "immhi:immlo" times 4096.</p>
        
      </td></tr></table></div><div class="syntax-notes"></div>
    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode">let base : bits(64) = <a href="shared_pseudocode.html#func_PC64_0" title="">PC64</a>()[63:12]::Zeros{12};
<a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{64}(d) = base + imm;</p></div>
