          </span></h3><div class="regdiagram-32"><table class="regdiagram"><thead><tr><td>31</td><td>30</td><td>29</td><td>28</td><td>27</td><td>26</td><td>25</td><td>24</td><td>23</td><td>22</td><td>21</td><td>20</td><td>19</td><td>18</td><td>17</td><td>16</td><td>15</td><td>14</td><td>13</td><td>12</td><td>11</td><td>10</td><td>9</td><td>8</td><td>7</td><td>6</td><td>5</td><td>4</td><td>3</td><td>2</td><td>1</td><td>0</td></tr></thead><tbody><tr class="firstrow"><td class="l">1</td><td>1</td><td class="r">1</td><td class="l">0</td><td>0</td><td>1</td><td class="r">0</td><td class="l">1</td><td class="r">0</td><td class="lr">0</td><td class="lr">0</td><td colspan="5" class="lr">Rm</td><td class="l">0</td><td>0</td><td class="r">1</td><td colspan="3" class="lr">Pg</td><td colspan="5" class="lr">Zn</td><td colspan="5" class="lr">Zt</td></tr><tr class="secondrow"><td colspan="3"></td><td colspan="4"></td><td colspan="2" class="droppedname">msz</td><td></td><td></td><td colspan="5"></td><td colspan="3"></td><td colspan="3"></td><td colspan="5"></td><td colspan="5"></td></tr></tbody></table></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">Encoding</h4><a id="stnt1w_z_p_ar_d_64_unscaled"></a></div><p class="asm-code">STNT1W  { <a href="#Zt" title='Is the name of the scalable vector register to be transferred, encoded in the "Zt" field.'>&lt;Zt&gt;</a>.D }, <a href="#Pg" title='Is the name of the governing scalable predicate register P0-P7, encoded in the "Pg" field.'>&lt;Pg&gt;</a>, [<a href="#Zn__3" title='Is the name of the base scalable vector register, encoded in the "Zn" field.'>&lt;Zn&gt;</a>.D{, <a href="#Xm__5" title='Is the optional 64-bit name of the general-purpose offset register, defaulting to XZR, encoded in the "Rm" field.'>&lt;Xm&gt;</a>}]</p></div><h4>Decode</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_SVE2) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
