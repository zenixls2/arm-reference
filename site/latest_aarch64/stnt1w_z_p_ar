e.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
let t : integer = UInt(Zt);
let n : integer = UInt(Zn);
let m : integer = UInt(Rm);
let g : integer = UInt(Pg);
let esize : integer{} = 32;
let msize : integer{} = 32;</p>
    <h3 class="classheading"><a id="iclass_64_bit_unscaled_offset"></a>64-bit unscaled offset class
