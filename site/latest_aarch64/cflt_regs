    </p><a href="/">← Home</a><pagefind-searchbox></pagefind-searchbox><script type="module" src="/pagefind/pagefind-component-ui.js"></script><script type="text/javascript" src="/static/pagefind.js"></script><h1 class="instruction-section" data-pagefind-body="1" data-pagefind-weight="10" data-pagefind-sort="title">CFLT&lt;cc&gt; (register)</h1><p class="insn_subtitle" data-pagefind-body="1">Compare registers and fault</p>
      <p class="aml" data-pagefind-body="1">This instruction compares the values in two registers, and
generates a Conditional fault exception if the condition is true.
This instruction does not affect the condition flags.</p>
    <p class="desc">This instruction is used by the pseudo-instructions <a href="cfltle_regs.html" title="Compare registers and fault if less than or equal">CFLTLE (register)</a>, <a href="cfltlo_regs.html" title="Compare registers and fault if lower">CFLTLO (register)</a>, <a href="cfltls_regs.html" title="Compare registers and fault if lower than or same">CFLTLS (register)</a>, and <a href="cfltlt_regs.html" title="Compare registers and fault if less than">CFLTLT (register)</a>.</p>
    <h3 class="classheading"><a id="iclass_fault"></a>Fault class
        <span style="font-size:smaller;"><br></br>(FEAT_CFLT)
          </span></h3><p class="desc"></p><div class="regdiagram-32"><table class="regdiagram"><thead><tr><td>31</td><td>30</td><td>29</td><td>28</td><td>27</td><td>26</td><td>25</td><td>24</td><td>23</td><td>22</td><td>21</td><td>20</td><td>19</td><td>18</td><td>17</td><td>16</td><td>15</td><td>14</td><td>13</td><td>12</td><td>11</td><td>10</td><td>9</td><td>8</td><td>7</td><td>6</td><td>5</td><td>4</td><td>3</td><td>2</td><td>1</td><td>0</td></tr></thead><tbody><tr class="firstrow"><td class="lr">sf</td><td class="l">1</td><td>1</td><td>1</td><td>0</td><td>1</td><td>1</td><td class="r">0</td><td colspan="3" class="lr">cc</td><td colspan="5" class="lr">Rm</td><td class="l">0</td><td>0</td><td>0</td><td class="r">0</td><td colspan="2" class="lr">imm2</td><td class="l">1</td><td>0</td><td>0</td><td>0</td><td class="r">0</td><td colspan="5" class="lr">Rt</td></tr></tbody></table></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">32-bit greater than encoding
            </h4><a id="CFLTGT_32_regs"></a><span class="bitdiff"> (sf == 0 &amp;&amp; cc == 000)</span></div><p class="asm-code">CFLTGT  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#WtWSP_option" title='Is the 32-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Wt|WSP&gt;</a>, <a href="#WmWSP_option__2" title='Is the 32-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Wm|WSP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">32-bit greater than or equal encoding
            </h4><a id="CFLTGE_32_regs"></a><span class="bitdiff"> (sf == 0 &amp;&amp; cc == 001)</span></div><p class="asm-code">CFLTGE  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#WtWSP_option" title='Is the 32-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Wt|WSP&gt;</a>, <a href="#WmWSP_option__2" title='Is the 32-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Wm|WSP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">32-bit higher encoding
            </h4><a id="CFLTHI_32_regs"></a><span class="bitdiff"> (sf == 0 &amp;&amp; cc == 010)</span></div><p class="asm-code">CFLTHI  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#WtWSP_option" title='Is the 32-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Wt|WSP&gt;</a>, <a href="#WmWSP_option__2" title='Is the 32-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Wm|WSP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">32-bit higher or same encoding
            </h4><a id="CFLTHS_32_regs"></a><span class="bitdiff"> (sf == 0 &amp;&amp; cc == 011)</span></div><p class="asm-code">CFLTHS  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#WtWSP_option" title='Is the 32-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Wt|WSP&gt;</a>, <a href="#WmWSP_option__2" title='Is the 32-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Wm|WSP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">32-bit equal encoding
            </h4><a id="CFLTEQ_32_regs"></a><span class="bitdiff"> (sf == 0 &amp;&amp; cc == 110)</span></div><p class="asm-code">CFLTEQ  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#WtWSP_option" title='Is the 32-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Wt|WSP&gt;</a>, <a href="#WmWSP_option__2" title='Is the 32-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Wm|WSP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">32-bit not equal encoding
            </h4><a id="CFLTNE_32_regs"></a><span class="bitdiff"> (sf == 0 &amp;&amp; cc == 111)</span></div><p class="asm-code">CFLTNE  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#WtWSP_option" title='Is the 32-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Wt|WSP&gt;</a>, <a href="#WmWSP_option__2" title='Is the 32-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Wm|WSP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">64-bit greater than encoding
            </h4><a id="CFLTGT_64_regs"></a><span class="bitdiff"> (sf == 1 &amp;&amp; cc == 000)</span></div><p class="asm-code">CFLTGT  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#XtSP_option__3" title='Is the 64-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Xt|SP&gt;</a>, <a href="#XmSP_option__2" title='Is the 64-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Xm|SP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">64-bit greater than or equal encoding
            </h4><a id="CFLTGE_64_regs"></a><span class="bitdiff"> (sf == 1 &amp;&amp; cc == 001)</span></div><p class="asm-code">CFLTGE  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#XtSP_option__3" title='Is the 64-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Xt|SP&gt;</a>, <a href="#XmSP_option__2" title='Is the 64-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Xm|SP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">64-bit higher encoding
            </h4><a id="CFLTHI_64_regs"></a><span class="bitdiff"> (sf == 1 &amp;&amp; cc == 010)</span></div><p class="asm-code">CFLTHI  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#XtSP_option__3" title='Is the 64-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Xt|SP&gt;</a>, <a href="#XmSP_option__2" title='Is the 64-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Xm|SP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">64-bit higher or same encoding
            </h4><a id="CFLTHS_64_regs"></a><span class="bitdiff"> (sf == 1 &amp;&amp; cc == 011)</span></div><p class="asm-code">CFLTHS  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#XtSP_option__3" title='Is the 64-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Xt|SP&gt;</a>, <a href="#XmSP_option__2" title='Is the 64-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Xm|SP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">64-bit equal encoding
            </h4><a id="CFLTEQ_64_regs"></a><span class="bitdiff"> (sf == 1 &amp;&amp; cc == 110)</span></div><p class="asm-code">CFLTEQ  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#XtSP_option__3" title='Is the 64-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Xt|SP&gt;</a>, <a href="#XmSP_option__2" title='Is the 64-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Xm|SP&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">64-bit not equal encoding
            </h4><a id="CFLTNE_64_regs"></a><span class="bitdiff"> (sf == 1 &amp;&amp; cc == 111)</span></div><p class="asm-code">CFLTNE  #<a href="#cflt_reason" title='Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.'>&lt;reason&gt;</a>, <a href="#XtSP_option__3" title='Is the 64-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.'>&lt;Xt|SP&gt;</a>, <a href="#XmSP_option__2" title='Is the 64-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.'>&lt;Xm|SP&gt;</a></p></div><h4>Decode (all encodings)</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_CFLT) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;

let datasize : integer{} = 32 &lt;&lt; UInt(sf);
let t : integer = UInt(Rt);
let m : integer = UInt(Rm);
let reason : bits(16) = ZeroExtend{}(imm2);

var cmp : <a href="shared_pseudocode.html#type_CmpOp" title="">CmpOp</a>;
var unsigned : boolean;

case cc of
    when '000' =&gt; cmp = <a href="shared_pseudocode.html#enum_Cmp_GT" title="">Cmp_GT</a>; unsigned = FALSE;
    when '001' =&gt; cmp = <a href="shared_pseudocode.html#enum_Cmp_GE" title="">Cmp_GE</a>; unsigned = FALSE;
    when '010' =&gt; cmp = <a href="shared_pseudocode.html#enum_Cmp_GT" title="">Cmp_GT</a>; unsigned = TRUE;
    when '011' =&gt; cmp = <a href="shared_pseudocode.html#enum_Cmp_GE" title="">Cmp_GE</a>; unsigned = TRUE;
    when '110' =&gt; cmp = <a href="shared_pseudocode.html#enum_Cmp_EQ" title="">Cmp_EQ</a>; unsigned = TRUE;
    when '111' =&gt; cmp = <a href="shared_pseudocode.html#enum_Cmp_NE" title="">Cmp_NE</a>; unsigned = TRUE;
    otherwise  =&gt; <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>);
end;</p>
  <div class="encoding-notes"></div><h2 class="explanations">Assembler Symbols</h2><div class="explanations"><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;reason&gt;</td><td><a id="cflt_reason"></a>
        
          <p class="aml" data-pagefind-body="1">Is a 2-bit unsigned immediate, in the range 0 to 3, encoded in the "imm2" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;Wt|WSP&gt;</td><td><a id="WtWSP_option"></a>
        
          <p class="aml" data-pagefind-body="1">Is the 32-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;Wm|WSP&gt;</td><td><a id="WmWSP_option__2"></a>
        
          <p class="aml" data-pagefind-body="1">Is the 32-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;Xt|SP&gt;</td><td><a id="XtSP_option__3"></a>
        
          <p class="aml" data-pagefind-body="1">Is the 64-bit name of the general-purpose register or stack pointer to be tested, encoded in the "Rt" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;Xm|SP&gt;</td><td><a id="XmSP_option__2"></a>
        
          <p class="aml" data-pagefind-body="1">Is the 64-bit name of the second general-purpose source register or stack pointer, encoded in the "Rm" field.</p>
        
      </td></tr></table></div><div class="syntax-notes"></div>
    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckCFLTEnabled_0" title="">CheckCFLTEnabled</a>();

let operand1 : bits(datasize) = if t == 31 then <a href="shared_pseudocode.html#accessor_SP_1" title="">SP</a>{datasize}() else <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{datasize}(t);
let operand2 : bits(datasize) = if m == 31 then <a href="shared_pseudocode.html#accessor_SP_1" title="">SP</a>{datasize}() else <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{datasize}(m);

var cond : boolean;
let value1 : integer = if unsigned then UInt(operand1) else SInt(operand1);
let value2 : integer = if unsigned then UInt(operand2) else SInt(operand2);
case cmp of
    when <a href="shared_pseudocode.html#enum_Cmp_EQ" title="">Cmp_EQ</a> =&gt; cond = value1 == value2;
    when <a href="shared_pseudocode.html#enum_Cmp_NE" title="">Cmp_NE</a> =&gt; cond = value1 != value2;
    when <a href="shared_pseudocode.html#enum_Cmp_GT" title="">Cmp_GT</a> =&gt; cond = value1 &gt;  value2;
    when <a href="shared_pseudocode.html#enum_Cmp_GE" title="">Cmp_GE</a> =&gt; cond = value1 &gt;= value2;
end;

if cond then
    let isflt : boolean = FALSE;
    AArch64_ConditionalFault(isflt, reason);
end;</p></div>
