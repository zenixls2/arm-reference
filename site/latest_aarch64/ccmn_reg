    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode">if <a href="shared_pseudocode.html#func_ConditionHolds_1" title="">ConditionHolds</a>(condition) then
    let operand1 : bits(datasize) = <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{datasize}(n);
    let operand2 : bits(datasize) = <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{datasize}(m);

    (-, flags) = <a href="shared_pseudocode.html#func_AddWithCarry_4" title="">AddWithCarry</a>{datasize}(operand1, operand2, '0');
end;
PSTATE.[N,Z,C,V] = flags;</p></div>
