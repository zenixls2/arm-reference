let esize : integer{} = 64;
let g : integer = UInt(Pg);
let n : integer = UInt(Zn);
let level : integer = UInt(prfop[2:1]);
let stream : boolean = (prfop[0] == '1');
let pref_hint : <a href="shared_pseudocode.html#type_PrefetchHint" title="">PrefetchHint</a> = if prfop[3] == '0' then <a href="shared_pseudocode.html#enum_Prefetch_READ" title="">Prefetch_READ</a> else <a href="shared_pseudocode.html#enum_Prefetch_WRITE" title="">Prefetch_WRITE</a>;
