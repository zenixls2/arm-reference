    </p><a href="/">← Home</a><pagefind-searchbox></pagefind-searchbox><script type="module" src="/pagefind/pagefind-component-ui.js"></script><script type="text/javascript" src="/static/pagefind.js"></script><h1 class="instruction-section" data-pagefind-body="1" data-pagefind-weight="10" data-pagefind-sort="title">PRFD (vector plus immediate)</h1><p class="insn_subtitle" data-pagefind-body="1">Gather prefetch doublewords (vector plus immediate)</p>
      <p class="aml" data-pagefind-body="1">This instruction performs a gather prefetch of  doublewords from the active memory addresses generated by a
 vector base plus immediate index.
The index is a multiple of 8 in the range 0 to 248.
Inactive addresses are not prefetched from memory.</p>
      <p class="aml" data-pagefind-body="1">The &lt;prfop&gt; operand specifies the prefetch hint as follows:</p>
      <ul>
        <li>
          Access type:<ul>
              <li>
                PLD for prefetch for load.
              </li>
              <li>
                PST for prefetch for store.
              </li>
            </ul>
          
        </li>
        <li>
          Target cache level:<ul>
              <li>
                L1 for Level 1 cache.
              </li>
              <li>
                L2 for Level 2 cache.
              </li>
              <li>
                L3 for Level 3 cache.
              </li>
            </ul>
          
        </li>
        <li>
          Policy:<ul>
              <li>
                KEEP for retained or temporal prefetch, allocated in the cache normally.
              </li>
              <li>
                STRM for streaming or non-temporal prefetch, for data that is used only once.
              </li>
            </ul>
          
        </li>
      </ul>
      <p class="aml" data-pagefind-body="1">This instruction is illegal when executed in Streaming SVE mode, unless FEAT_SME_FA64 is implemented and enabled.</p>
    
    <p class="desc">
      It has encodings from 2 classes:
      <a href="#iclass_32_bit_element">32-bit element</a>
       and 
      <a href="#iclass_64_bit_element">64-bit element</a>
    </p>
    <h3 class="classheading"><a id="iclass_32_bit_element"></a>32-bit element class
        <span style="font-size:smaller;"><br></br>(FEAT_SVE)
          </span></h3><div class="regdiagram-32"><table class="regdiagram"><thead><tr><td>31</td><td>30</td><td>29</td><td>28</td><td>27</td><td>26</td><td>25</td><td>24</td><td>23</td><td>22</td><td>21</td><td>20</td><td>19</td><td>18</td><td>17</td><td>16</td><td>15</td><td>14</td><td>13</td><td>12</td><td>11</td><td>10</td><td>9</td><td>8</td><td>7</td><td>6</td><td>5</td><td>4</td><td>3</td><td>2</td><td>1</td><td>0</td></tr></thead><tbody><tr class="firstrow"><td class="l">1</td><td>0</td><td class="r">0</td><td class="l">0</td><td>0</td><td>1</td><td class="r">0</td><td class="l">1</td><td class="r">1</td><td class="l">0</td><td class="r">0</td><td colspan="5" class="lr">imm5</td><td class="l">1</td><td>1</td><td class="r">1</td><td colspan="3" class="lr">Pg</td><td colspan="5" class="lr">Zn</td><td class="lr">0</td><td colspan="4" class="lr">prfop</td></tr><tr class="secondrow"><td colspan="3"></td><td colspan="4"></td><td colspan="2" class="droppedname">msz</td><td colspan="2"></td><td colspan="5"></td><td colspan="3"></td><td colspan="3"></td><td colspan="5"></td><td></td><td colspan="4"></td></tr></tbody></table></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">Encoding</h4><a id="prfd_i_p_ai_s"></a></div><p class="asm-code">PRFD  <a href="#prfop" title="Is the prefetch operation specifier, ">&lt;prfop&gt;</a>, <a href="#Pg" title='Is the name of the governing scalable predicate register P0-P7, encoded in the "Pg" field.'>&lt;Pg&gt;</a>, [<a href="#Zn__3" title='Is the name of the base scalable vector register, encoded in the "Zn" field.'>&lt;Zn&gt;</a>.S{, #<a href="#imm__62" title='Is the optional unsigned immediate byte offset, a multiple of 8 in the range 0 to 248, defaulting to 0, encoded in the "imm5" field.'>&lt;imm&gt;</a>}]</p></div><h4>Decode</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_SVE) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
let esize : integer{} = 32;
let g : integer = UInt(Pg);
let n : integer = UInt(Zn);
let level : integer = UInt(prfop[2:1]);
let stream : boolean = (prfop[0] == '1');
let pref_hint : <a href="shared_pseudocode.html#type_PrefetchHint" title="">PrefetchHint</a> = if prfop[3] == '0' then <a href="shared_pseudocode.html#enum_Prefetch_READ" title="">Prefetch_READ</a> else <a href="shared_pseudocode.html#enum_Prefetch_WRITE" title="">Prefetch_WRITE</a>;
let scale : integer = 3;
let offset : integer = UInt(imm5);</p>
    <h3 class="classheading"><a id="iclass_64_bit_element"></a>64-bit element class
        <span style="font-size:smaller;"><br></br>(FEAT_SVE)
          </span></h3><div class="regdiagram-32"><table class="regdiagram"><thead><tr><td>31</td><td>30</td><td>29</td><td>28</td><td>27</td><td>26</td><td>25</td><td>24</td><td>23</td><td>22</td><td>21</td><td>20</td><td>19</td><td>18</td><td>17</td><td>16</td><td>15</td><td>14</td><td>13</td><td>12</td><td>11</td><td>10</td><td>9</td><td>8</td><td>7</td><td>6</td><td>5</td><td>4</td><td>3</td><td>2</td><td>1</td><td>0</td></tr></thead><tbody><tr class="firstrow"><td class="l">1</td><td>1</td><td class="r">0</td><td class="l">0</td><td>0</td><td>1</td><td class="r">0</td><td class="l">1</td><td class="r">1</td><td class="l">0</td><td class="r">0</td><td colspan="5" class="lr">imm5</td><td class="l">1</td><td>1</td><td class="r">1</td><td colspan="3" class="lr">Pg</td><td colspan="5" class="lr">Zn</td><td class="lr">0</td><td colspan="4" class="lr">prfop</td></tr><tr class="secondrow"><td colspan="3"></td><td colspan="4"></td><td colspan="2" class="droppedname">msz</td><td colspan="2"></td><td colspan="5"></td><td colspan="3"></td><td colspan="3"></td><td colspan="5"></td><td></td><td colspan="4"></td></tr></tbody></table></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">Encoding</h4><a id="prfd_i_p_ai_d"></a></div><p class="asm-code">PRFD  <a href="#prfop" title="Is the prefetch operation specifier, ">&lt;prfop&gt;</a>, <a href="#Pg" title='Is the name of the governing scalable predicate register P0-P7, encoded in the "Pg" field.'>&lt;Pg&gt;</a>, [<a href="#Zn__3" title='Is the name of the base scalable vector register, encoded in the "Zn" field.'>&lt;Zn&gt;</a>.D{, #<a href="#imm__62" title='Is the optional unsigned immediate byte offset, a multiple of 8 in the range 0 to 248, defaulting to 0, encoded in the "imm5" field.'>&lt;imm&gt;</a>}]</p></div><h4>Decode</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_SVE) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum