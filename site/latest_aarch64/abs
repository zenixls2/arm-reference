    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode">let operand1 : bits(datasize) = <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{datasize}(n);
let result : integer = Abs(SInt(operand1));

<a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{datasize}(d) = result[datasize-1:0];</p></div>
