          </span></h3><p class="desc"></p><div class="regdiagram-32"><table class="regdiagram"><thead><tr><td>31</td><td>30</td><td>29</td><td>28</td><td>27</td><td>26</td><td>25</td><td>24</td><td>23</td><td>22</td><td>21</td><td>20</td><td>19</td><td>18</td><td>17</td><td>16</td><td>15</td><td>14</td><td>13</td><td>12</td><td>11</td><td>10</td><td>9</td><td>8</td><td>7</td><td>6</td><td>5</td><td>4</td><td>3</td><td>2</td><td>1</td><td>0</td></tr></thead><tbody><tr class="firstrow"><td class="lr">sf</td><td class="lr">1</td><td class="lr">0</td><td class="l">1</td><td>1</td><td>0</td><td>1</td><td>0</td><td>1</td><td>1</td><td class="r">0</td><td class="l">0</td><td>0</td><td>0</td><td>0</td><td class="r">0</td><td class="l">0</td><td>0</td><td>1</td><td>0</td><td>0</td><td class="r">0</td><td colspan="5" class="lr">Rn</td><td colspan="5" class="lr">Rd</td></tr><tr class="secondrow"><td></td><td></td><td class="droppedname">S</td><td colspan="8"></td><td colspan="5" class="droppedname">opcode2</td><td colspan="6" class="droppedname">opcode</td><td colspan="5"></td><td colspan="5"></td></tr></tbody></table></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">32-bit encoding
            </h4><a id="ABS_32_dp_1src"></a><span class="bitdiff"> (sf == 0)</span></div><p class="asm-code">ABS  <a href="#WdOrWZR" title='Is the 32-bit name of the general-purpose destination register, encoded in the "Rd" field.'>&lt;Wd&gt;</a>, <a href="#WnOrWZR" title='Is the 32-bit name of the general-purpose source register, encoded in the "Rn" field.'>&lt;Wn&gt;</a></p></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">64-bit encoding
            </h4><a id="ABS_64_dp_1src"></a><span class="bitdiff"> (sf == 1)</span></div><p class="asm-code">ABS  <a href="#XdOrXZR__6" title='Is the 64-bit name of the general-purpose destination register, encoded in the "Rd" field.'>&lt;Xd&gt;</a>, <a href="#XnOrXZR__11" title='Is the 64-bit name of the general-purpose source register, encoded in the "Rn" field.'>&lt;Xn&gt;</a></p></div><h4>Decode (all encodings)</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_CSSC) then <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>); end;
let datasize : integer{} = 32 &lt;&lt; UInt(sf);
let d : integer{} = UInt(Rd);
let n : integer{} = UInt(Rn);</p>
