    </p><a href="/">← Home</a><pagefind-searchbox></pagefind-searchbox><script type="module" src="/pagefind/pagefind-component-ui.js"></script><script type="text/javascript" src="/static/pagefind.js"></script><h1 class="instruction-section" data-pagefind-body="1" data-pagefind-weight="10" data-pagefind-sort="title">TBZ</h1><p class="insn_subtitle" data-pagefind-body="1">Test bit and branch if zero</p>
      <p class="aml" data-pagefind-body="1">This instruction compares the value of a test bit with zero,
and conditionally branches to a label at a PC-relative offset if the
comparison is equal.
This instruction provides a hint that this is not a subroutine call or return.
This instruction does not affect condition flags.</p>
    
    <p class="desc"></p><div class="regdiagram-32"><table class="regdiagram"><thead><tr><td>31</td><td>30</td><td>29</td><td>28</td><td>27</td><td>26</td><td>25</td><td>24</td><td>23</td><td>22</td><td>21</td><td>20</td><td>19</td><td>18</td><td>17</td><td>16</td><td>15</td><td>14</td><td>13</td><td>12</td><td>11</td><td>10</td><td>9</td><td>8</td><td>7</td><td>6</td><td>5</td><td>4</td><td>3</td><td>2</td><td>1</td><td>0</td></tr></thead><tbody><tr class="firstrow"><td class="lr">b5</td><td class="l">0</td><td class="r">1</td><td class="l">1</td><td>0</td><td class="r">1</td><td class="lr">1</td><td class="lr">0</td><td colspan="5" class="lr">b40</td><td colspan="14" class="lr">imm14</td><td colspan="5" class="lr">Rt</td></tr><tr class="secondrow"><td></td><td colspan="2"></td><td colspan="3"></td><td></td><td class="droppedname">op</td><td colspan="5"></td><td colspan="14"></td><td colspan="5"></td></tr></tbody></table></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">Encoding</h4><a id="TBZ_only_testbranch"></a></div><p class="asm-code">TBZ  <a href="#R_option" title="Is a width specifier, ">&lt;R&gt;</a><a href="#Rt_option" title='Is the number [0-30] of the general-purpose register to be tested or the name ZR (31), encoded in the "Rt" field.'>&lt;t&gt;</a>, #<a href="#imm_0_63" title='Is the bit number to be tested, in the range 0 to 63, encoded in "b5:b40".'>&lt;imm&gt;</a>, <a href="#imm14_offset" title='Is the program label to be conditionally branched to. Its offset from the address of this instruction, in the range +/-32KB, is encoded as "imm14" times 4.'>&lt;label&gt;</a></p></div><h4>Decode</h4><p class="pseudocode">let t : integer = UInt(Rt);

let datasize : integer{} = 32 &lt;&lt; UInt(b5);
let bit_pos : integer = UInt(b5::b40);
let offset : bits(64) = SignExtend{}(imm14::'00');</p>
  <div class="encoding-notes"></div><h2 class="explanations">Assembler Symbols</h2><div class="explanations"><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;R&gt;</td><td><a id="R_option"></a>
        <p>Is a width specifier, 
          encoded in
          <q>b5</q>:
            </p>
        <table class="valuetable">
          
            <thead>
              <tr>
                <th class="bitfield">b5</th>
                <th class="symbol">&lt;R&gt;</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="bitfield">0</td>
                <td class="symbol">W</td>
              </tr>
              <tr>
                <td class="bitfield">1</td>
                <td class="symbol">X</td>
              </tr>
            </tbody>
          
        </table>
        In assembler source code an 'X' specifier is always permitted, but a 'W' specifier is permitted only when the bit number is less than 32.
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;t&gt;</td><td><a id="Rt_option"></a>
        
          <p class="aml" data-pagefind-body="1">Is the number [0-30] of the general-purpose register to be tested or the name ZR (31), encoded in the "Rt" field.</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;imm&gt;</td><td><a id="imm_0_63"></a>
        
          <p class="aml" data-pagefind-body="1">Is the bit number to be tested, in the range 0 to 63, encoded in "b5:b40".</p>
        
      </td></tr></table><table><col class="asyn-l"></col><col class="asyn-r"></col><tr><td>&lt;label&gt;</td><td><a id="imm14_offset"></a>
        
          <p class="aml" data-pagefind-body="1">Is the program label to be conditionally branched to. Its offset from the address of this instruction, in the range +/-32KB, is encoded as "imm14" times 4.</p>
        
      </td></tr></table></div><div class="syntax-notes"></div>
    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode">let operand : bits(datasize) = <a href="shared_pseudocode.html#accessor_X_2" title="">X</a>{datasize}(t);
let branch_conditional : boolean = TRUE;
if operand[bit_pos] == '0' then
    <a href="shared_pseudocode.html#func_BranchTo_4" title="">BranchTo</a>{64}(<a href="shared_pseudocode.html#func_PC64_0" title="">PC64</a>() + offset, <a href="shared_pseudocode.html#enum_BranchType_DIR" title="">BranchType_DIR</a>, branch_conditional);
else
    <a href="shared_pseudocode.html#func_BranchNotTaken_2" title="">BranchNotTaken</a>(<a href="shared_pseudocode.html#enum_BranchType_DIR" title="">BranchType_DIR</a>, branch_conditional);
end;</p></div>
