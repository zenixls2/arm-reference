    </p><a href="/">← Home</a><pagefind-searchbox></pagefind-searchbox><script type="module" src="/pagefind/pagefind-component-ui.js"></script><script type="text/javascript" src="/static/pagefind.js"></script><h1 class="instruction-section" data-pagefind-body="1" data-pagefind-weight="10" data-pagefind-sort="title">SBCLT</h1><p class="insn_subtitle" data-pagefind-body="1">Subtract with carry long (top)</p>
      <p class="aml" data-pagefind-body="1">This instruction subtracts the odd-numbered elements of the first
source vector and the inverted
1-bit carry from the
least-significant bit of the odd-numbered elements of the
second source vector from the even-numbered elements of
the destination and accumulator vector. The 1-bit carry output
is placed in the corresponding odd-numbered element of the
destination vector.</p>
    
    <h3 class="classheading"><a id="iclass_sve2"></a>SVE2 class
        <span style="font-size:smaller;"><br></br>(FEAT_SVE2 || FEAT_SME)
          </span></h3><p class="desc"></p><div class="regdiagram-32"><table class="regdiagram"><thead><tr><td>31</td><td>30</td><td>29</td><td>28</td><td>27</td><td>26</td><td>25</td><td>24</td><td>23</td><td>22</td><td>21</td><td>20</td><td>19</td><td>18</td><td>17</td><td>16</td><td>15</td><td>14</td><td>13</td><td>12</td><td>11</td><td>10</td><td>9</td><td>8</td><td>7</td><td>6</td><td>5</td><td>4</td><td>3</td><td>2</td><td>1</td><td>0</td></tr></thead><tbody><tr class="firstrow"><td class="l">0</td><td>1</td><td class="r">0</td><td class="l">0</td><td>0</td><td>1</td><td class="r">0</td><td class="lr">1</td><td class="lr">1</td><td class="lr">sz</td><td class="lr">0</td><td colspan="5" class="lr">Zm</td><td class="l">1</td><td class="r">1</td><td class="l">0</td><td>1</td><td class="r">0</td><td class="lr">1</td><td colspan="5" class="lr">Zn</td><td colspan="5" class="lr">Zda</td></tr><tr class="secondrow"><td colspan="3"></td><td colspan="4"></td><td></td><td></td><td></td><td></td><td colspan="5"></td><td colspan="2"></td><td colspan="3"></td><td class="droppedname">T</td><td colspan="5"></td><td colspan="5"></td></tr></tbody></table></div><div class="encoding"><div class="encoding__label"><h4 class="encoding">Encoding</h4><a id="sbclt_z_zzz_"></a></div><p class="asm-code">SBCLT  <a href="#Zda" title='Is the name of the third source and destination scalable vector register, encoded in the "Zda" field.'>&lt;Zda&gt;</a>.<a href="#T__2" title="Is the size specifier, ">&lt;T&gt;</a>, <a href="#Zn__2" title='Is the name of the first source scalable vector register, encoded in the "Zn" field.'>&lt;Zn&gt;</a>.<a href="#T__2" title="Is the size specifier, ">&lt;T&gt;</a>, <a href="#Zm" title='Is the name of the second source scalable vector register, encoded in the "Zm" field.'>&lt;Zm&gt;</a>.<a href="#T__2" title="Is the size specifier, ">&lt;T&gt;</a></p></div><h4>Decode</h4><p class="pseudocode">if !IsFeatureImplemented(FEAT_SVE2) &amp;&amp; !IsFeatureImplemented(FEAT_SME) then
    <a href="shared_pseudocode.html#func_EndOfDecode_1" title="">EndOfDecode</a>(<a href="shared_pseudocode.html#enum_Decode_UNDEF" title="">Decode_UNDEF</a>);
end;
let esize : integer{} = 32 &lt;&lt; UInt(sz);
let n : integer = UInt(Zn);
let m : integer = UInt(Zm);
let da : integer = UInt(Zda);</p>
