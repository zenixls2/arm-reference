    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_AArch64_CheckFPAdvSIMDEnabled_0" title="">AArch64_CheckFPAdvSIMDEnabled</a>();
let operand1 : bits(datasize) = V{}(n);
let operand2 : bits(idxdsize) = V{}(m);
let operand3 : bits(datasize) = V{}(d);
var result : bits(datasize);
var element1 : integer;
var element2 : integer;
var product : bits(esize);

element2 = UInt(operand2[index*:esize]);
for e = 0 to elements-1 do
    element1 = UInt(operand1[e*:esize]);
    product = (element1 * element2)[esize-1:0];
    result[e*:esize] = operand3[e*:esize] - product;
end;
<a href="shared_pseudocode.html#accessor_V_2" title="">V</a>{datasize}(d) = result;</p></div>
