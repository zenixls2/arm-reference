    <div class="ps"><a id=""></a><h2 class="pseudocode">Operation</h2>
      <p class="pseudocode"><a href="shared_pseudocode.html#func_CheckNonStreamingSVEEnabled_0" title="">CheckNonStreamingSVEEnabled</a>();
let VL : integer{} = <a href="shared_pseudocode.html#func_CurrentVL_0" title="">CurrentVL</a>();
let elements : integer = VL DIV esize;
let operand1 : bits(VL) = Z{}(n);
let operand2 : bits(VL) = Z{}(m);
var result : bits(VL);

for e = 0 to elements-1 do
    let element1 : bits(esize) = operand1[e*:esize];
    let element2 : bits(esize) = operand2[e*:esize];
    result[e*:esize] = <a href="shared_pseudocode.html#func_FPTrigSSel_3" title="">FPTrigSSel</a>{esize}(element1, element2);
end;

<a href="shared_pseudocode.html#accessor_Z_2" title="">Z</a>{VL}(d) = result;</p></div>
