    else
        SMPRIMAP_EL2() = X{64}(t);
    end;
elsif PSTATE.EL == EL3 then
    if CPTR_EL3().ESM == '0' then
        AArch64_SystemAccessTrap(EL3, 0x18);
    else
        SMPRIMAP_EL2() = X{64}(t);
